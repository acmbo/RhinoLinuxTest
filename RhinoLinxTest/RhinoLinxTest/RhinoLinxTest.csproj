<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;DebuLinux</Configurations>
    <PlatformTarget>x64</PlatformTarget> 
  </PropertyGroup>
	
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform(linux))">
		<TargetFramework>net9.0</TargetFramework>
		<DefineConstants>LINUX</DefineConstants>
		<RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform(windows))">
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>


	<ItemGroup Condition="$([MSBuild]::IsOSPlatform(linux))">
		
		<PackageReference Include="Rhino.Inside" Version="9.0.10-beta" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform(windows))">
		<PackageReference Include="Rhino.Inside" Version="8.0.7-beta" />
	</ItemGroup>


	<ItemGroup> 
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Serilog" Version="4.3.1" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform(linux))">
		<PackageReference Include="System.Drawing.Common" Version="9.0.0" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\RhinoLib\RhinoLib.csproj" />
	</ItemGroup>
</Project>
