<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against RhinoCommon, but always load the installed runtime copy via Rhino.Inside. -->
    <PackageReference Include="RhinoCommon" Version="9.0.25350.305-wip" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
