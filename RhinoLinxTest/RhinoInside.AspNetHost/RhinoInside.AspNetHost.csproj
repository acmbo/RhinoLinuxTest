<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.0</RuntimeFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rhino.Inside" Version="9.0.26084.13070-beta" />
    <!-- Compile against RhinoCommon, but always load the installed runtime copy via Rhino.Inside. -->
    <PackageReference Include="RhinoCommon" Version="9.0.25350.305-wip" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
