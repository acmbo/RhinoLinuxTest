<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RhinoComputeLinuxRepro/RhinoComputeLinuxRepro.csproj" />
    <PackageReference Include="Rhino.Inside" Version="9.0.26084.13070-beta" />
    <!-- Compile against RhinoCommon; Rhino.Inside resolves the installed runtime copy. -->
    <PackageReference Include="RhinoCommon" Version="9.0.25350.305-wip" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
